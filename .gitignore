# Dependencies
node_modules/
**/node_modules/

# Next.js
.next/
**/.next/
out/
**/out/

# Production build
build/
dist/

# Environment variables — block all .env* variants except the example template
.env*
!.env.example

# Testing (Playwright output — regenerable, never commit)
playwright-report/
test-results/

# Misc
.DS_Store
*.pem
*.tsbuildinfo
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vercel
.vercel

# Brag video output (/brag skill) — large rendered MP4s, screenshots and a
# scaffolded Hyperframes project with its own node_modules. All regenerable.
brag-output*/

# UI screenshot captures (scripts/capture-ui.mjs, change 011 FR-14) — review
# artifacts, regenerable, never commit.
ui-captures/

# specclaw concurrency locks (per-run, never shared)
.specclaw/changes/*/.lock/

# specclaw run logs (per-run output, never shared)
.specclaw/changes/*/logs/

# specclaw machine-local state (version-check cache, eval journal)
.specclaw/.update-check
.specclaw/changes/eval/
