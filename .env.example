# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# better-auth (self-hosted — generate secret with: openssl rand -hex 32)
# BETTER_AUTH_SECRET is REQUIRED (the app refuses to start with the placeholder in production).
BETTER_AUTH_SECRET=your-32-byte-hex-secret
BETTER_AUTH_URL=http://localhost:3000

# Database (PostgreSQL via Docker Compose)
DATABASE_URL=postgresql://bistec:bistec@localhost:5432/bistec_studio

# PostgreSQL container credentials (used by docker-compose.yml's postgres
# service). Keep them consistent with DATABASE_URL above.
POSTGRES_DB=bistec_studio
POSTGRES_USER=bistec
POSTGRES_PASSWORD=bistec

# MinIO (S3-compatible object storage via Docker Compose)
MINIO_ENDPOINT=http://localhost:9000
# Browser-facing base URL for PUBLIC objects (logos, brand artifacts, generated
# images, brief uploads). Defaults to MINIO_ENDPOINT — set this only when MinIO
# is reached internally on one host (e.g. http://minio:9000) but served to
# browsers from another (e.g. https://cdn.example.com). The IMAGES and BRANDKITS
# buckets are made public-read on startup; EXPORTS stays private (signed per read).
# MINIO_PUBLIC_ENDPOINT=http://localhost:9000
# App-side credentials. The "minioadmin" defaults are dev-only — production
# refuses to start with them (fail-closed check in src/lib/env.ts).
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# MinIO server root credentials (used by docker-compose.yml's minio service).
# Keep them consistent with MINIO_ACCESS_KEY / MINIO_SECRET_KEY above.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# Bucket names (optional — these are the defaults).
MINIO_BUCKET_IMAGES=generated-images
MINIO_BUCKET_EXPORTS=exported-designs
MINIO_BUCKET_BRANDKITS=brand-kits
# Private bucket for campaign source documents (AI briefing assistant).
MINIO_BUCKET_DOCS=campaign-docs

# Anthropic (https://console.anthropic.com) — ONLY needed in API mode
# (DESIGN_PROVIDER=claude-html). CLI mode (the standard dev setup) never uses
# it: auth comes from the user's connected Claude account (/settings) or the
# team's shared credential (/team), and the CLI spawn strips this var from the
# child env anyway.
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI, Claude CLI OAuth token, MCP allow-lists, and social channel tokens
# are no longer configured via env vars — they're managed in-app:
#   - Personal credentials (your own Claude/OpenAI keys): /settings
#   - Team credentials (shared Claude/OpenAI keys, social channels, MCP/ACP
#     API keys): /team (team admins only)

# Design provider: "claude-html" (production) or "cli" (test mode — uses Claude Code CLI, no API key needed)
DESIGN_PROVIDER=claude-html

# Path to the Claude Code CLI binary (optional). Used in CLI mode
# (DESIGN_PROVIDER=cli). Usually leave it unset: a bare `claude` is found on
# PATH, and on Windows it goes through cmd.exe, whose PATHEXT lookup finds either
# the native `claude.exe` or the npm shim `claude.cmd`. When set, the path runs
# directly with no shell, so on Windows it must be an executable such as
# claude.exe — a .cmd/.bat shim cannot be spawned without a shell.
# CLAUDE_CLI_PATH=C:\Users\me\.local\bin\claude.exe

# CLI-mode auth (DESIGN_PROVIDER=cli): the long-lived OAuth token from
# `claude setup-token` is no longer read from the environment. Users connect
# their own Claude account at /settings (takes precedence for their
# generations); a team's shared token is set at /team and covers users without
# a personal token, the scheduler worker, and MCP/ACP callers.

# System default model (008): haiku | sonnet | opus (any case), or a full current
# model ID from src/lib/models/catalogue.ts (e.g. claude-sonnet-5-5). CLI mode
# only (DESIGN_PROVIDER=cli); in API mode it is ignored, with a boot warning.
# It is the system default on every user surface where that model is eligible,
# BELOW team defaults (/team → Models) and explicit picks: it no longer
# overrides them. Leave UNSET for the per-surface defaults (captions and
# template fill → Haiku, freeform design and the assistants → Sonnet).
# "default", a retired ID or any other value is rejected and fails the boot
# in either mode (an invalid value is never "ignored").
# CLAUDE_CLI_MODEL=sonnet

# CLI-mode diagnostics (DESIGN_PROVIDER=cli). On by default: logs each `claude -p`
# spawn, a liveness heartbeat, streamed stderr, and elapsed time — so a timeout is
# debuggable. Set to 0 to silence.
CLAUDE_CLI_DEBUG=1

# Hero image quality (009): standard | high (any case). Applies only to the image
# of a hero image style (Product showcase, Editorial split), never to a classic
# post. OpenAI maps standard to medium and high to high; Gemini ignores it.
# `high` is slower and dearer (an image can take up to two minutes) and its
# worth is decided on prod by the OP-1 comparison, so leave it UNSET until then.
# Unset, blank or an unknown value means the provider's own default.
# IMAGE_QUALITY=high

# Puppeteer / headless Chromium (HTML → PNG rendering)
# Path to the Chromium/Chrome binary. Optional on Linux (common install paths
# are auto-detected); REQUIRED on Windows/macOS.
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Max concurrent renders (optional, default 2). Each render rasterizes at 2× DPI
# and is memory-heavy — raise with care.
# PUPPETEER_MAX_CONCURRENCY=2

# Token encryption — generate with: openssl rand -hex 32
# REQUIRED (the app refuses to start with the placeholder in production).
TOKEN_ENCRYPTION_KEY=your-32-byte-hex-key

# MCP server / external API access (optional — the MCP server and the ACP/MCP
# generate/publish capabilities stay locked without them)
# API key the local MCP server presents to the app.
# MCP_API_KEY=
# Team-scoped MCP/ACP API keys (replacing the old BISTEC_API_KEYS /
# BISTEC_ADMIN_API_KEYS allow-lists) are issued in-app at /team by a team admin.

# Social channel tokens (Instagram, LinkedIn) are no longer read from the
# environment — register them per team at /team → Social Channels (stored
# encrypted in the DB).

# Test seams (E2E suite only — dormant unless exactly "true"; NEVER set in
# production; see src/lib/testHooks.ts and docs/e2e-test-plan.md)
# MOCK_AI=true
# MOCK_PUPPETEER=true
# MOCK_SOCIAL=true
# MOCK_SOCIAL_FAIL=true
