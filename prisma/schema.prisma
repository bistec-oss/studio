generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum DesignMode {
  TEMPLATE
  GENERATE
}

// Output canvas shape. SQUARE = 1080×1080 (1:1), PORTRAIT = 1080×1350 (4:5).
// Pixel dimensions live in src/lib/aspectRatio.ts (single source of truth).
enum AspectRatio {
  SQUARE
  PORTRAIT
  STORY
}

enum DraftStatus {
  IN_PROGRESS
  EXPORTED
  PUBLISHED
  FAILED
}

// A draft action (regenerate/refine) running in the background via the F1
// async pattern. Claimed atomically at request time; cleared when the run
// settles. Distinct from DraftStatus — the draft keeps its content/status
// while an action is in flight.
enum DraftAction {
  REGENERATE_COPY
  REGENERATE_DESIGN
  REFINE
  APPLY_TEXT
}

enum Channel {
  INSTAGRAM
  LINKEDIN
  WHATSAPP
}

// One caption row's state (012 FR-02). PENDING = a generation or regenerate is
// writing it now; READY = validated model output or the user's own text (may
// be empty); FAILED = the last attempt produced no usable text AND the row has
// none — the DraftCaption_failed_has_no_text CHECK constraint enforces that.
enum CaptionStatus {
  PENDING
  READY
  FAILED
}

enum PostStatus {
  PENDING
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
}

// Lifecycle of a scheduled post generation (mirrors Post's H12 machinery:
// RUNNING overloads nextRetryAt as the worker lease deadline).
enum GenerationStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

// What happens after a scheduled generation completes: hold the draft for
// human review, auto-create SCHEDULED posts at publishAt, or publish at once.
enum PostGenerationAction {
  HOLD
  SCHEDULE_PUBLISH
  PUBLISH_NOW
}

enum ProviderSlot {
  COPY
  IMAGE
}

// Lifecycle of a user's personal Claude OAuth token (`claude setup-token`).
// INVALID = an auth failure was observed mid-call (expired/revoked); the UI
// prompts the user to reconnect and generation falls back to the shared token.
enum ClaudeTokenStatus {
  ACTIVE
  INVALID
}

enum ArtifactType {
  LOGO
  FONT
  COLOR
  REFERENCE_IMAGE
  REFERENCE_DOC
  EXAMPLE_POST
  OTHER
}

// A catalogue key: a model family, not a version (008 A1). The values are
// src/lib/models/catalogue.ts MODEL_KEYS (tests/unit/modelCatalogue.test.ts
// pins the two together); the full API ID lives only in the catalogue and in
// the stamps. A new family is `ALTER TYPE … ADD VALUE`, alone in its migration.
enum ModelKey {
  HAIKU
  SONNET
  OPUS
}

// The surfaces a team admin can set a default for (008 FR-02) — catalogue.ts
// USER_SURFACES. Internal surfaces (background decision, verifier, token ping)
// are fixed on Haiku and never persisted (A14).
enum ModelSurface {
  CAPTION
  DESIGN_TEMPLATE
  DESIGN_FREEFORM
  REFINE
  ASSISTANT_BRIEFING
  ASSISTANT_BRANDKIT
}

// ── better-auth models ────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  // Sign-in identity (better-auth username plugin): `username` is the
  // lowercase unique handle, `displayUsername` preserves the entered casing.
  // Email is kept internally (better-auth requires it) but is not the login.
  username        String?   @unique
  displayUsername String?
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // app-level role (managed server-side only — never writable via sign-up)
  role          Role      @default(EDITOR)
  // deactivated accounts keep their content/attribution but cannot log in;
  // toggled only by super-admins via /api/admin/users
  disabled      Boolean   @default(false)
  // better-auth relations
  sessions      Session[]
  accounts      Account[]
  // app relations
  briefs        Brief[]
  posts         Post[]
  scheduledGenerations ScheduledGeneration[]
  claudeToken   UserClaudeToken?
  briefDrafts   BriefDraft[]
  teamMemberships TeamMembership[]
  openAiKey     UserOpenAiKey?
}

// An UNFINISHED brief-wizard session (autosaved working state), NOT a Brief:
// a Brief is only ever created at Generate time. The payload is wizard-shaped
// (step index, image intents, template selections) and zod-validated at the
// service layer (src/lib/brief/briefDrafts.ts), which also owns the 5-per-user
// cap and the 7-day lazy TTL sweep. Owner-only — admins cannot read other
// users' unfinished briefs (private working state, unlike generated drafts).
model BriefDraft {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic     String   @default("") // denormalized from payload for dashboard rows
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
  @@index([teamId])
}

// A user's personal Claude Code OAuth token (pasted from `claude setup-token`).
// Used by CLI-mode generation (`claude -p`) so calls bill the user's own Claude
// subscription; absent/INVALID rows fall back to the shared server token.
// Separate 1:1 model (not fields on User) so the ciphertext never rides along
// in the widely-selected better-auth User rows. Mirrors the AvailableProvider
// secret pattern: AES-256-GCM ciphertext + a display-only masked suffix.
model UserClaudeToken {
  id              String            @id @default(cuid())
  userId          String            @unique
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  encryptedToken  String // AES-256-GCM via src/lib/crypto.ts — never returned to clients
  keyPrefix       String // display-only masked suffix `…${token.slice(-4)}`
  status          ClaudeTokenStatus @default(ACTIVE)
  lastValidatedAt DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
}

// ── Team tenancy ──────────────────────────────────────────────────────────

enum TeamRole {
  ADMIN
  EDITOR
}

model Team {
  id                   String           @id @default(cuid())
  // Uniqueness is scoped to LIVE teams only via a partial unique index
  // (`Team_name_active_key ... WHERE "isDeleted" = false`, see migration
  // 20260726120000_team_name_unique_active). A plain @unique here would also
  // count soft-deleted rows, so a deleted team's name could never be reused.
  // Because the column is no longer a Prisma unique field, name lookups use
  // findFirst({ name, isDeleted: false }), not findUnique.
  name                 String
  isDeleted            Boolean          @default(false)
  deletedAt            DateTime?
  createdAt            DateTime         @default(now())
  // Team Claude token (scheduler + member fallback), AES-256-GCM via src/lib/crypto.ts
  encryptedClaudeToken String?
  claudeKeyPrefix      String?
  memberships          TeamMembership[]
  // The team's model policy (008 FR-05); absent until an admin first saves it.
  modelPolicy          TeamModelPolicy?
  // 024: the credential route the team chose for captions. Null = never chosen
  // (today's behaviour, unchanged).
  captionRoute         CaptionRoute?
}

// 024: the credential route a team can choose for captions. The stamp columns
// (Draft.headlineRoute, DraftCaption.route) are plain TEXT because their domain
// (CLI | API_KEY | SERVER_KEY | OTHER) is wider than this setting's.
enum CaptionRoute {
  CLI
  API_KEY
}

// A team's model policy (008 FR-05), 1:1 with Team. No row = the catalogue's
// defaultAllowed entries, no team defaults, switch off (A2). Once saved, the
// list is authoritative: a later catalogue addition is never added silently.
model TeamModelPolicy {
  teamId                       String             @id
  team                         Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  // The models this team may run on user surfaces; checked at every tier at
  // call time (a stored value no longer allowed falls to the team default).
  allowedModels                ModelKey[]
  // The "Opus requires a personal token" switch (A3): gates every catalogue
  // entry flagged personalTokenGated, in CLI mode only.
  requirePersonalTokenForGated Boolean            @default(false)
  updatedAt                    DateTime           @default(now()) @updatedAt
  defaults                     TeamModelDefault[]
}

// One team default per user surface (008 FR-05). A missing row means "use the
// system default" (FR-04's table, then CLAUDE_CLI_MODEL in CLI mode).
model TeamModelDefault {
  teamId  String
  policy  TeamModelPolicy @relation(fields: [teamId], references: [teamId], onDelete: Cascade)
  surface ModelSurface
  model   ModelKey

  @@id([teamId, surface])
}

model TeamMembership {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      TeamRole
  createdAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([userId])
}

// Personal OpenAI key, mirrors UserClaudeToken (encrypted + masked prefix, 1 row/user)
model UserOpenAiKey {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  encryptedKey String
  keyPrefix    String
  status       String   @default("ACTIVE") // ACTIVE | INVALID
  // 031 FR-10: which provider the key belongs to (`openai` | `gemini`), from its
  // prefix at save time. The table keeps its name (user decision).
  provider     String   @default("openai")
  createdAt    DateTime @default(now())
}

// Machine-caller keys for MCP/ACP, replaces env BISTEC_API_KEYS.
// Stored hashed (never read back); the plaintext is shown once at creation.
model ApiKey {
  id        String    @id @default(cuid())
  teamId    String
  label     String
  keyHash   String    @unique
  keyPrefix String
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([teamId])
}

// ── App models ────────────────────────────────────────────────────────────

model Project {
  id                String            @id @default(cuid())
  teamId            String
  name              String
  defaultBrandKitId String?
  defaultBrandKit   BrandKit?         @relation("ProjectBrandKit", fields: [defaultBrandKitId], references: [id])
  defaultTone       String?
  isDeleted         Boolean           @default(false)
  deletedAt         DateTime?
  createdAt         DateTime          @default(now())
  campaigns         ProjectCampaign[]

  @@index([teamId])
}

model Campaign {
  id           String             @id @default(cuid())
  teamId       String
  name         String
  brandKitId   String?
  brandKit     BrandKit?          @relation("CampaignBrandKit", fields: [brandKitId], references: [id])
  defaultTone  String?
  // 027: pre-fills the wizard, the queue and (as the default) MCP/ACP. Plain TEXT,
  // validated in code (src/lib/postStyles), so a retired key needs no migration.
  defaultPostStyle String?
  isDeleted    Boolean            @default(false)
  deletedAt    DateTime?
  createdAt    DateTime           @default(now())
  projects     ProjectCampaign[]
  briefs       Brief[]
  briefings    CampaignBriefing[]
  scheduledGenerations ScheduledGeneration[]
  documents    CampaignDocument[]

  @@index([teamId])
}

// A source document (strategy deck, product one-pager, …) handed in by an
// admin to ground the AI briefing assistant. The original file lives in the
// private campaign-docs MinIO bucket; parsedText is the extracted plain text
// (capped — `truncated` marks a cut) injected into briefing chat/enhance prompts.
model CampaignDocument {
  id          String   @id @default(cuid())
  teamId      String
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id])
  name        String
  contentType String
  sizeBytes   Int
  objectKey   String
  parsedText  String   @db.Text
  truncated   Boolean  @default(false)
  createdBy   String
  createdAt   DateTime @default(now())

  @@index([campaignId])
  @@index([teamId])
}

// A planned post under a campaign: per-post brief specifics + a generation
// time. The scheduler worker claims due entries (FOR UPDATE SKIP LOCKED, same
// pattern as Post publishing), generates a Draft via the shared pipeline, then
// executes postAction. Retries with backoff on failure; FAILED is re-runnable.
model ScheduledGeneration {
  id          String               @id @default(cuid())
  teamId      String
  campaignId  String
  campaign    Campaign             @relation(fields: [campaignId], references: [id])
  createdById String
  createdBy   User                 @relation(fields: [createdById], references: [id])
  // Per-post brief specifics (the campaign briefing carries the rest).
  topic       String
  description String?
  goal        String
  tone        String
  // 027: the post style key (TEXT, validated in code). Null = before 027.
  postStyle   String?
  channels    Channel[]
  aspectRatio AspectRatio          @default(SQUARE)
  designMode  DesignMode
  templateId  String?
  template    BrandKitTemplate?    @relation("ScheduledGenerationTemplate", fields: [templateId], references: [id])
  // Scheduling
  generateAt  DateTime
  postAction  PostGenerationAction @default(HOLD)
  publishAt   DateTime?
  // Lifecycle — mirrors Post's H12 fields (nextRetryAt doubles as the RUNNING lease).
  status      GenerationStatus     @default(PENDING)
  errorReason String?
  // 027: why a post action was not run (the facts check). Null otherwise.
  heldReason  String?
  retryCount  Int                  @default(0)
  nextRetryAt DateTime?
  // Results: the Brief is created on the first run attempt and reused across
  // retries; the Draft is set on success.
  briefId     String?
  brief       Brief?               @relation(fields: [briefId], references: [id])
  draftId     String?
  draft       Draft?               @relation(fields: [draftId], references: [id])
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @default(now()) @updatedAt

  @@index([status, generateAt])
  @@index([status, nextRetryAt])
  @@index([campaignId])
  @@index([teamId])
}

// Versioned free-text campaign briefing — the campaign-level "80% of the brief"
// injected into copy/design prompts for every post under the campaign, on top of
// the brand kit's voice prompt. Versioning mirrors BrandKitPrompt: exactly one
// isActive row per campaign; restore = re-activate an old version.
model CampaignBriefing {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  content    String   @db.Text
  version    Int      @default(1)
  isActive   Boolean  @default(false)
  createdBy  String
  createdAt  DateTime @default(now())

  @@unique([campaignId, version])
}

model ProjectCampaign {
  projectId  String
  campaignId String
  project    Project  @relation(fields: [projectId], references: [id])
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  @@id([projectId, campaignId])
}

model Brief {
  id                  String             @id @default(cuid())
  teamId              String
  userId              String
  user                User               @relation(fields: [userId], references: [id])
  campaignId          String?
  campaign            Campaign?          @relation(fields: [campaignId], references: [id])
  brandKitId          String?
  brandKit            BrandKit?          @relation("BriefBrandKit", fields: [brandKitId], references: [id])
  topic               String
  description         String?
  goal                String
  tone                String
  channels            Channel[]
  aspectRatio         AspectRatio        @default(SQUARE)
  designMode          DesignMode
  copyProviderKey     String
  imageProviderKey    String?
  additionalImageUrl  String?
  briefImages         Json?
  referenceTemplateId String?
  referenceTemplate   BrandKitTemplate?  @relation("BriefReferenceTemplate", fields: [referenceTemplateId], references: [id])
  // The initial generation's explicit model request (008 FR-10), read only by
  // the generation and its retry as tier 1. designModel serves DESIGN_TEMPLATE
  // or DESIGN_FREEFORM by designMode. Null = no explicit request; wave 1 never
  // writes them.
  captionModel        ModelKey?
  designModel         ModelKey?
  // 009 FR-01: the requested hero-image style. Plain TEXT, validated in code,
  // so a retired key needs no migration. The default keeps every pre-009 row
  // (and the previous image's brief.create) on the classic plan.
  imageStyle          String             @default("classic")
  compositeSource     Json?
  // 027: the post style key (TEXT, validated in code, so a retired key needs
  // no migration). Null = before 027: the user's own goal and tone stand.
  postStyle           String?
  createdAt           DateTime           @default(now())
  drafts              Draft[]
  scheduledGenerations ScheduledGeneration[]

  @@index([userId])
  @@index([campaignId])
  @@index([brandKitId])
  @@index([teamId])
}

model Draft {
  id              String          @id @default(cuid())
  teamId          String
  briefId         String
  brief           Brief           @relation(fields: [briefId], references: [id])
  imageUrl        String?
  htmlContent     String?         @db.Text
  templateId      String?
  exportUrl       String?
  pendingConflict Json?
  // Which DraftRevision is currently active (revisionNumber, not id). The design
  // history is an append-only log of DraftRevision rows; this pointer says which
  // one the live htmlContent/exportUrl mirror, so reverting can move freely back
  // AND forward without losing states. Null for legacy rows created before this
  // field existed (treated as "latest revision").
  currentRevisionNumber Int?
  // Prompt revision that produced the current design (prompts/shared.ts
  // PROMPT_VERSION) — lets output quality be correlated with prompt changes.
  promptVersion   String?
  // Digest of the installed font packages at render time (src/lib/renderer/
  // fontSet.ts getFontSetId) — the glyph environment is global (an image
  // rebuild can change how an already-approved draft renders) so this makes
  // that attributable after the fact. Null for drafts rendered before this
  // existed, or off a host with no apk database (e.g. local dev) — absent,
  // not wrong.
  fontSet         String?
  status          DraftStatus     @default(IN_PROGRESS)
  // Why the last generation attempt FAILED (model error, timeout, interruption).
  // Shown on the preview page's inline error card; cleared on a successful retry.
  failureReason   String?
  // In-flight draft action marker for the async action pattern (regenerate
  // copy/design, refine): set on atomic claim, cleared when the run settles.
  pendingAction   DraftAction?
  // Token minted by the claim (change 019). Set with the claim, nulled by every
  // settle and by the stale sweep; every write the run makes is guarded on it.
  // Null alongside a non-null pendingAction means an older image took the claim.
  pendingActionClaimId String?
  // Error from the last action run. The claim keeps it (since 004 T17 fix
  // round 1); the next settle replaces or clears it.
  pendingActionError String?
  // "Couldn't apply" outcome of the last refine (change 004 FR-14): the refine
  // ran to completion but failed verification twice, so nothing was committed.
  // Deliberately separate from pendingActionError — "did not do what you asked"
  // must read differently from "the run crashed". Cleared by the next
  // successful action.
  notAppliedReason     String?
  // The retained rejected render for that outcome (a DraftRevision with
  // rejectedAt set and no revisionNumber) — never a chain row. SetNull so the
  // draft hard-delete, which removes revisions first, is unaffected.
  notAppliedRevisionId String?
  notAppliedRevision   DraftRevision? @relation("DraftNotAppliedRevision", fields: [notAppliedRevisionId], references: [id], onDelete: SetNull)
  // Why the current design has no AI background, when that was NOT the
  // model's choice (005 FR-06/FR-07): NO_PROVIDER | PROVIDER_ERROR |
  // DECISION_ERROR, enforced in src/lib/drafts/backgroundNotice.ts (plain TEXT
  // so a new reason needs no migration). NOT_NEEDED is never stored. The
  // detail is the clipped (≤300 chars) error text. Null = no notice.
  backgroundSkipReason String?
  backgroundSkipDetail String?
  // 031 FR-13: where the image that ran came from, `{ tier: 'personal' | 'team',
  // provider: 'openai' | 'gemini', personalFailed?: true }`. Null = before 031 or
  // no image provider ran.
  imageSource          Json?
  // The short line printed on the post image (012 FR-03/FR-09), written by the
  // caption call. Null until it writes a valid one — design then falls back
  // to the brief topic (captions/headline.ts designHeadline).
  headline        String?
  // The model that wrote `headline` (008 FR-08): the arg that crossed the
  // boundary (apiId in API mode, cliArg in CLI mode). Plain TEXT, so a retired
  // or non-Claude ID is kept as history. Null = unknown (pre-008). A headline
  // edit leaves it (A6). …SubstitutedFrom = the refused value, or null.
  headlineModel                String?
  headlineModelSubstitutedFrom String?
  // 024: the route that wrote `headline` (CLI | API_KEY | SERVER_KEY | OTHER),
  // as TEXT, beside headlineModel. Written only with validated text. Null =
  // before 024, or unknown.
  headlineRoute                String?
  // Mirrors the current revision's DraftRevision.model / modelSubstitutedFrom
  // (008 FR-08): the model whose output is the live htmlContent.
  designModel                  String?
  designModelSubstitutedFrom   String?
  // 009: the composition stamp for the live htmlContent, validated in
  // src/lib/designData/stamp.ts (tolerant parse at read). Null = before 009.
  composition     Json?
  // 027: the post style stamp { key, version, revision } of the last generation or
  // regeneration, validated in src/lib/postStyles/stamp.ts. Null = before 027.
  postStyle       Json?
  // 030: the text the live render visibly painted, { headline: { text, verified, reason? } },
  // validated in src/lib/renderedText/stamp.ts. Null = rendered before 030.
  renderedText    Json?
  // 031 FR-24: what the live render noted, { fontsMissing: string[] } (the
  // post-font families that did not load), validated in src/lib/fonts/renderNotes.ts.
  // Null = before 031, no check, or nothing missing.
  renderNotes     Json?
  // 027: the facts-check result (numbers and places only, no text). Null = never checked.
  factsCheck      Json?
  createdAt       DateTime        @default(now())
  // @default(now()) keeps the added column valid for pre-existing rows
  updatedAt       DateTime        @default(now()) @updatedAt
  posts           Post[]
  revisions       DraftRevision[] @relation("DraftRevisions")
  scheduledGenerations ScheduledGeneration[]
  // Per-channel captions (012 FR-02). Read only through captions/store.ts
  // loadDraftCaptions, which materializes legacy drafts first.
  captions        DraftCaption[]

  @@index([briefId])
  @@index([teamId])
  // FK lookup side for ON DELETE SET NULL when a rejected DraftRevision is removed.
  @@index([notAppliedRevisionId])
}

model Post {
  id          String     @id @default(cuid())
  teamId      String
  draftId     String
  draft       Draft      @relation(fields: [draftId], references: [id])
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  channel     Channel
  status      PostStatus @default(PENDING)
  scheduledAt DateTime?
  publishedAt DateTime?
  platformId  String?
  errorReason String?
  retryCount  Int        @default(0)
  nextRetryAt DateTime?
  createdAt   DateTime   @default(now())
  // @default(now()) keeps the added column valid for pre-existing rows
  updatedAt   DateTime   @default(now()) @updatedAt

  @@index([status, scheduledAt])
  @@index([status, nextRetryAt])
  @@index([draftId])
  @@index([userId])
  @@index([teamId])
}

model BrandKit {
  id        String              @id @default(cuid())
  teamId    String
  name      String
  colors    Json?
  fonts     Json?
  logoUrl   String?
  // 031 FR-21: the font per script, { [script]: family }, keyed by the catalogue's
  // script id (only `sinhala` is offered). Null = none (the default).
  scriptFonts Json?
  isDefault Boolean             @default(false)
  isDeleted Boolean             @default(false)
  deletedAt DateTime?
  createdAt DateTime            @default(now())
  prompts   BrandKitPrompt[]
  artifacts BrandKitArtifact[]
  templates BrandKitTemplate[]
  documents BrandKitDocument[]
  projects  Project[]           @relation("ProjectBrandKit")
  campaigns Campaign[]          @relation("CampaignBrandKit")
  briefs    Brief[]             @relation("BriefBrandKit")

  @@index([isDefault, isDeleted])
  @@index([teamId])
}

// Source documents/images grounding the brand-kit assistant chat — mirrors
// CampaignDocument. Deliberately NOT artifacts: they must never enter
// generation prompts (Path B reads only feedToAI artifacts).
model BrandKitDocument {
  id          String   @id @default(cuid())
  teamId      String
  brandKitId  String
  brandKit    BrandKit @relation(fields: [brandKitId], references: [id])
  name        String
  contentType String
  sizeBytes   Int
  objectKey   String
  parsedText  String   @db.Text
  truncated   Boolean  @default(false)
  createdBy   String
  createdAt   DateTime @default(now())

  @@index([brandKitId])
  @@index([teamId])
}

model BrandKitTemplate {
  id                 String   @id @default(cuid())
  brandKitId         String
  brandKit           BrandKit @relation(fields: [brandKitId], references: [id])
  name               String
  htmlTemplate       String   @db.Text
  aspectRatio        AspectRatio @default(SQUARE)
  createdAt          DateTime @default(now())
  referencedByBriefs Brief[]  @relation("BriefReferenceTemplate")
  scheduledGenerations ScheduledGeneration[] @relation("ScheduledGenerationTemplate")

  @@index([brandKitId])
}

model BrandKitPrompt {
  id         String   @id @default(cuid())
  brandKitId String
  brandKit   BrandKit @relation(fields: [brandKitId], references: [id])
  content    String
  version    Int      @default(1)
  isActive   Boolean  @default(false)
  createdBy  String
  createdAt  DateTime @default(now())
  // 031 (T12): the kit fonts before an assistant apply that changed them, so the
  // History line can name them. Null = the version changed no fonts.
  previousFonts Json?

  @@unique([brandKitId, version])
}

model BrandKitArtifact {
  id         String       @id @default(cuid())
  brandKitId String
  brandKit   BrandKit     @relation(fields: [brandKitId], references: [id])
  type       ArtifactType
  name       String
  url        String
  feedToAI   Boolean      @default(false)
  // REFERENCE_DOC only: text extracted at upload time (PDF/DOCX/TXT/MD), fed
  // to the brand-kit assistant as grounding — mirrors CampaignDocument.
  parsedText String?      @db.Text
  truncated  Boolean      @default(false)
  createdAt  DateTime     @default(now())

  @@index([brandKitId])
}

model AvailableProvider {
  id              String       @id @default(cuid())
  teamId          String
  slot            ProviderSlot
  providerKey     String
  providerName    String
  label           String
  keyPrefix       String
  encryptedApiKey String
  isEnabled       Boolean      @default(true)
