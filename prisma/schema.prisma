  @@unique([teamId, slot, providerKey])
  @@index([teamId])
}

model ChannelToken {
  id                String   @id @default(cuid())
  teamId            String
  channel           Channel
  encryptedToken    String
  encryptedMetadata String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([teamId, channel])
  @@index([teamId])
}

// Two kinds of row share this table (change 004, Phase 2 — FR-12/13/14):
//
//  * COMMITTED rows are the revision chain: revisionNumber 1..N, contiguous per
//    draft, the only rows Draft.currentRevisionNumber can point at, and the only
//    rows version switching / restore / Undo / next-number allocation see.
//  * REJECTED rows are refine renders that failed verification twice. They are
//    kept for diagnosis (and a possible "Use anyway" adoption) but are NOT part
//    of the chain: they have NO revisionNumber at all (NULL), plus rejectedAt.
//
// A rejected row has no chain position by construction, so the pointer (an Int
// compared to revisionNumber) can never select one and next-number allocation
// can never count one. The migration adds a CHECK constraint making
// "revisionNumber IS NULL" and "rejectedAt IS NOT NULL" the same statement.
// Every reader still filters through committedRevisionWhere() in
// src/lib/drafts/revisions.ts — never query this table for the chain directly.
model DraftRevision {
  id             String   @id @default(cuid())
  draftId        String
  draft          Draft    @relation("DraftRevisions", fields: [draftId], references: [id])
  // Chain position. NULL exactly when the row is rejected (CHECK constraint).
  revisionNumber Int?
  instruction    String
  htmlSnapshot   String   @db.Text
  exportUrl      String?
  createdAt      DateTime @default(now())
  // Set when the render failed verification twice (FR-13). Non-null ⇔ rejected.
  rejectedAt     DateTime?
  // Free-form diagnostics for a rejected render: the classes the instruction
  // resolved to and the verifier's stated miss (FR-13). Deliberately untyped JSON
  // and allowed ONLY on rejected rows (CHECK constraint).
  // FR-02 vs FR-13 ruling: FR-02 says the instruction class is transient and is
  // not written to DraftRevision; FR-13 says a rejected render is labelled with
  // its classes. FR-13 is the more specific requirement for rejected rows, so
  // classes are stored here and ONLY here — never as a typed column and never
  // on a committed row.
  rejection      Json?
  // "Use anyway" (FR-14a, T19): when the rejected render was adopted, and the
  // committed revisionNumber its fresh copy became. The rejected row itself is
  // never pointed at; a non-null adoptedAt makes a second adopt a 409.
  adoptedAt             DateTime?
  adoptedRevisionNumber Int?
  // Set when a rejected render is dismissed/superseded, so adopting it later is
  // a 409 (FR-14a "already-adopted or discarded").
  discardedAt    DateTime?
  // The render stamp of THIS row's render (F3, AC-04): the prompt version that
  // produced htmlSnapshot and the font set that rasterized exportUrl — the
  // same values Draft.promptVersion/fontSet carry while the draft shows it.
  // Restore and "Use anyway" copy them back onto the draft. Null on rows
  // written before this existed (unknown, and copied as null).
  promptVersion  String?
  fontSet        String?
  // The model whose output is this row's htmlSnapshot (008 FR-08), part of the
  // same render stamp: the arg that crossed the boundary, as plain TEXT. Null =
  // unknown (pre-008). modelSubstitutedFrom = the refused value, or null.
  model                String?
  modelSubstitutedFrom String?
  // 009: the composition stamp of this row's htmlSnapshot, part of the same
  // render stamp, validated in src/lib/designData/stamp.ts. Null = before 009.
  composition          Json?
  // 027: the post style stamp at this row's render. Null = before 027.
  postStyle            Json?
  // 030: the text this row's render visibly painted. Null = rendered before 030.
  renderedText         Json?
  // 031 FR-24: what this row's render noted ({ fontsMissing }). Null = before 031,
  // no check, or nothing missing.
  renderNotes          Json?
  // Drafts whose current not-applied outcome references this rejected row.
  notAppliedOn   Draft[]  @relation("DraftNotAppliedRevision")

  @@unique([draftId, revisionNumber])
}

// One caption per draft per registry channel (012 FR-02, src/lib/channels.ts
// CAPTION_CHANNELS). Reached only through its draft, so every caption read and
// write sits behind the draft's access check; deleted with the draft.
// The migration adds the CHECK DraftCaption_failed_has_no_text:
// status <> 'FAILED' OR text = '' (A7 — FAILED means "no usable text").
model DraftCaption {
  id            String        @id @default(cuid())
  draftId       String
  draft         Draft         @relation(fields: [draftId], references: [id], onDelete: Cascade)
  channel       Channel
  text          String        @default("") @db.Text
  status        CaptionStatus @default(PENDING)
  // Why the last write attempt for this channel failed — also set on a failed
  // regenerate that left good text READY (A7). Cleared by the next successful
  // write or by an edit.
  failureReason String?
  // The model whose output is this row's text (008 FR-08), as plain TEXT: set
  // by the generation and a successful regenerate of this channel, left by a
  // user edit (A6) and by a failed field. Null = unknown (pre-008, or a FAILED
  // row with no text). modelSubstitutedFrom = the refused value, or null.
  model                String?
  modelSubstitutedFrom String?
  // 024: the route that wrote this row's text (CLI | API_KEY | SERVER_KEY |
  // OTHER), as TEXT, beside model. Written only with validated text. Null =
  // before 024, or no text.
  route                String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt

  @@unique([draftId, channel])
  @@index([draftId])
}

// The original single caption of every pre-012 draft that a database coming
// from `main` still held when 016 dropped Draft."copyText" (022 FR-01/FR-02).
// Written once by prisma/migrations/20261012130000_legacy_caption_carryover,
// which also copied the text into DraftCaption rows. A recovery record only:
// no app code reads it, nothing ever drops it, and on a fork-era database it
// is empty. Deliberately NO relation to Draft: it must survive a draft delete
// and must never block one.
model LegacyCaptionArchive {
  draftId    String   @id
  copyText   String   @db.Text
  archivedAt DateTime @default(now())
}

// 023: one row per scheduler-worker loop ('scheduler' | 'generation'). The
// table is global, not per team: the worker serves every team. The tick's
// start and end are kept apart so a long generation tick is not read as
// offline: lastTickEndedAt null, or before lastTickStartedAt, means "inside a
// tick". Written best-effort by the worker; read by GET /api/scheduler/status.
model WorkerHeartbeat {
  loop              String    @id
  lastTickStartedAt DateTime
  lastTickEndedAt   DateTime?
  updatedAt         DateTime  @updatedAt
}

// 006: where an analytics event came from. A Postgres enum because the set is
// closed and tiny; a new source is `ALTER TYPE … ADD VALUE`, alone in its migration.
enum AnalyticsSource {
  web
  scheduler
  mcp
}

// 006: the append-only product event store. Written only by track()
// (src/lib/analytics/track.ts), read only by src/lib/analytics/queries.ts.
// Deliberately NO relations: teamId, userId and draftId are plain strings, so
// the table never blocks a delete and never cascades by accident (006 FR-01,
// like LegacyCaptionArchive). Delete behaviour is explicit (006 FR-12).
model AnalyticsEvent {
  id            String          @id @default(cuid())
  at            DateTime        @default(now()) @db.Timestamptz(3)
  name          String
  schemaVersion Int
  source        AnalyticsSource
  teamId        String
  userId        String?
  draftId       String?
  durationMs    Int?
  outcome       String?
  payload       Json

  @@index([at])
  @@index([name, at])
  @@index([teamId, at])
  @@index([draftId])
}

// 006: events track() could not store (dropped) or would not store because the
// payload failed its schema (rejected), per event name. Shown on the insights
// page so a lost event never reads as a healthy zero.
model AnalyticsDrop {
  name       String   @id
  dropped    Int      @default(0)
  rejected   Int      @default(0)
  lastAt     DateTime @db.Timestamptz(3)
  lastReason String
}
